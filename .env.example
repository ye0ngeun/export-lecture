# ── 필수: SSAFY 계정 ─────────────────────────────────────
SSAFY_ID=your_id@example.com
SSAFY_PASSWORD=your_password

# ── 선택: 사이트 주소 ────────────────────────────────────
SSAFY_BASE_URL=https://edu.ssafy.com
SSAFY_LOGIN_URL=https://edu.ssafy.com/comm/login/SecurityLoginForm.do

# 로그인 폼 셀렉터 (비워두면 흔한 패턴을 자동으로 시도)
LOGIN_ID_SELECTOR=
LOGIN_PASSWORD_SELECTOR=
LOGIN_SUBMIT_SELECTOR=

# ── 선택: --discover 모드용 ──────────────────────────────
# 교안 목록이 있는 페이지 주소 (예: 강의실 > 자바 과목 페이지)
LECTURE_LIST_URL=
# 목록에서 e-book을 여는 링크/버튼 텍스트 (정규식)
EBOOK_LINK_PATTERN=교안|e-?book|이북|전자책
# 과목/강의 이름 필터 (정규식, 비우면 전부)
LECTURE_FILTER=자바|Java|JAVA

# ── 선택: 동작 옵션 ──────────────────────────────────────
OUTPUT_DIR=./downloads
# true면 브라우저 창을 띄우지 않음 (--watch 모드는 항상 창을 띄움)
HEADLESS=true
# 동시에 받을 페이지 이미지 수
CONCURRENCY=6
# 설치된 크롬을 쓰고 싶으면 chrome / msedge (비우면 Playwright 내장 Chromium)
BROWSER_CHANNEL=
# 브라우저 실행 파일 경로를 직접 지정할 때
BROWSER_EXECUTABLE_PATH=
